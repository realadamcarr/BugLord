# PUBLIC CLIENT CONFIGURATION
# Firebase client configuration. Copy this file to .env and fill in values
# from Firebase Console -> Project settings -> Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# iNaturalist metadata uses public, unauthenticated API endpoints and requires
# no client ID, client secret, account email, password, or reusable token.

# SERVER-ONLY SECRETS
# None are currently required for iNaturalist. If a future server operation
# needs private credentials, configure them in Firebase Functions Secret
# Manager or the backend host environment, never in this file.

# Do not add passwords, OAuth client secrets, service-account credentials, or
# signing credentials here. EXPO_PUBLIC_* values are embedded in the app.
